<?xml version="1.0" encoding="utf-8"?>
<!-- The agent talks to the local llmd HTTP API over http://127.0.0.1. Android
     blocks cleartext by default, so permit it for loopback ONLY (never the LAN);
     all other traffic stays cleartext-forbidden. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
